{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "drizzle-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{
			"pattern": "drizzle-mcp.liuma.app",
			"custom_domain": true
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}
