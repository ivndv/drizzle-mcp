{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "drizzle-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{
			"pattern": "drizzle-mcp.liuma.app",
			"custom_domain": true
		}
	],
	"observability": {
		// Interruptor general de observabilidad del Worker
		"enabled": false,
		// Fracción de requests registradas; 1 = todas
		"head_sampling_rate": 1,
		// Quita los query strings de las URLs en logs y trazas
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		// Spans de cada request: fetch salientes, bindings y DO
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			// Agrupa errores e invocaciones fallidas
			"enabled": true
		}
	}
}
